# Copy this file to .env and adjust values for this computer.
# The selected Ollama model must accept images as well as text.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision
# Optional overrides. Leave blank to use OLLAMA_MODEL for both passes.
OLLAMA_FAST_MODEL=
OLLAMA_DETAILED_MODEL=
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_CONCURRENCY=2

# SQLite database, temporary archive extraction, and completed case folders.
APP_DATA_DIR=./data
MAX_ARCHIVE_DEPTH=3
MAX_ARCHIVE_TOTAL_MB=2000
MAX_FILE_READ_MB=25

# Connected-phone staging. Leave the directory blank to use APP_DATA_DIR/tmp.
# Files are copied, analyzed, and removed in batches of this size.
PORTABLE_STAGE_DIR=
PORTABLE_STAGE_BATCH_GIB=5

# Local-only app server port. Change this if another program uses it.
APP_PORT=8731

# Multi-provider worker pool (v1.5) -- entirely optional, additive. Leaving
# all of this blank/default means zero behavior change from a plain local
# Ollama setup.
#
# Both providers' worker-slot API keys come from api_keys.py at the
# project root -- NOT here, since these are lists of secrets and a
# comma-separated string in .env is an easy way for a key to end up in a
# process listing or shell history. api_keys.py should be .gitignore'd, as
# a plain python file with two lists:
#   google_apikeys = ["key-1", "key-2", ...]   # one Gemini slot per entry
#   ollama_apikeys = ["key-1", "key-2", ...]   # one Ollama Cloud slot per entry
# A missing file, or either list missing/empty, means zero worker slots for
# that provider -- no crash, just one INFO log line at startup.

# Ollama Cloud: hosted Ollama, same request/response shape as local Ollama,
# just a different host + a Bearer API key per entry in ollama_apikeys.
OLLAMA_CLOUD_HOST=https://ollama.com

# Google Gemini: model/timeout are the only Gemini settings that stay in
# .env -- the keys themselves live in api_keys.py above.
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=120

# Optional hard cap on total worker slots (every Ollama Cloud key + every
# Gemini key combined). Blank = uncapped -- use every configured slot. This
# is the ONLY numeric worker-count setting anywhere in v1.5; every other
# slot count is derived from how many keys are actually configured.
WORKER_POOL_MAX_SLOTS=

# Optional comma-separated cloud keys; leave empty for local-only use.
GOOGLE_API_KEYS=
OLLAMA_API_KEYS=
